---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import BackgroundSettings from '../components/BackgroundSettings.astro';

interface Props { title?: string; description?: string; }
const { title = '个人书房 — 记录生活，思考世界', description = '一个记录生活、独立思考与观察世界的个人空间。' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9eee8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="site-header glass-panel">
        <a class="brand" href="/" aria-label="返回个人书房首页">
          <span class="brand-mark">书</span>
          <span>个人书房</span>
        </a>
        <nav class="nav-links" aria-label="主导航">
          <a href="/">首页</a>
          <a href="/archive/">归档</a>
          <a href="/search/">搜索</a>
          <a href="/about/">关于</a>
          <a class="wander-link" href="/wander/">随机漫游 ↗</a>
          <BackgroundSettings />
          <ThemeToggle />
        </nav>
      </header>
      
      
    </div>
  </body>
</html>
