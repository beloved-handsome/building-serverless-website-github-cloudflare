---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

interface Props { title?: string; description?: string; }
const { title = 'Beloved — A personal corner of the world', description = 'Beloved — a quiet space for time, place, weather, and writing.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const pathname = Astro.url.pathname;
const pageKey = pathname === '/' ? 'home'
  : pathname.startsWith('/archive') ? 'archive'
  : pathname.startsWith('/search') ? 'search'
  : pathname.startsWith('/about') ? 'about'
  : pathname.startsWith('/wander') ? 'wander'
  : pathname.startsWith('/posts/') ? 'posts' : 'default';
---
<!doctype html>
<html lang="zh-CN" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9eee8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const p = location.pathname;
        document.documentElement.dataset.page = p === '/' ? 'home' : p.startsWith('/archive') ? 'archive' : p.startsWith('/search') ? 'search' : p.startsWith('/about') ? 'about' : p.startsWith('/wander') ? 'wander' : p.startsWith('/posts/') ? 'posts' : 'default';
        try { document.documentElement.dataset.language = localStorage.getItem('study-room-language') || 'zh'; } catch { document.documentElement.dataset.language = 'zh'; }
      })();
    </script>
  </head>
  <body data-page={pageKey} >
    <div class="site-shell">
      <header class="site-header glass-panel notranslate" translate="no">
        <a class="brand" href="/" aria-label="Beloved home">
          <span class="brand-mark">B</span>
          <span>Beloved</span>
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/" data-i18n="nav.home">首页</a>
          <a href="/archive/" data-i18n="nav.archive">归档</a>
          <a href="/search/" data-i18n="nav.search">搜索</a>
          <a href="/about/" data-i18n="nav.about">关于</a>
          <a class="wander-link" href="/wander/" data-i18n="nav.wander">随机漫游 ↗</a>
          <LanguageSwitcher />
          <ThemeToggle />
        </nav>
      </header>
      <main>
        <slot />
      </main>
    </div>
    <div id="google_translate_element" class="google-translate-hidden" aria-hidden="true"></div>
    <script is:inline>
      (() => {
        const getPage = () => {
          const path = window.location.pathname.replace(/\/+$/, '') || '/';
          return path === '/' ? 'home'
            : path.startsWith('/archive') ? 'archive'
            : path.startsWith('/search') ? 'search'
            : path.startsWith('/about') ? 'about'
            : path.startsWith('/wander') ? 'wander'
            : path.startsWith('/posts/') ? 'posts' : 'default';
        };
        const applyPageBackground = () => {
          const body = document.body;
          if (!body) return;
          const page = getPage();
          body.dataset.page = page;
          const dark = document.documentElement.dataset.theme === 'dark';
          const overlay = dark
            ? (page === 'home' ? 'rgba(17,20,18,.42)' : 'rgba(17,20,18,.60)')
            : (page === 'home' ? 'rgba(247,248,244,.20)' : 'rgba(247,248,244,.36)');
          const supportedPages = ['home','archive','search','about','wander','posts'];
          const ownImage = supportedPages.includes(page) ? `/backgrounds/${page}/background.jpg` : null;
          const setBackground = (imageUrl) => {
            const imageLayer = imageUrl ? `, url("${imageUrl}")` : '';
            body.style.setProperty('background-image', `linear-gradient(${overlay},${overlay})${imageLayer}`, 'important');
          };
          if (!ownImage || page === 'home') {
            setBackground(ownImage);
          } else {
            const probe = new Image();
            probe.onload = () => setBackground(ownImage);
            probe.onerror = () => {
              // If a page-specific image has not been uploaded, use the homepage image.
              const fallback = new Image();
              fallback.onload = () => setBackground('/backgrounds/home/background.jpg');
              fallback.onerror = () => setBackground(null);
              fallback.src = '/backgrounds/home/background.jpg';
            };
            probe.src = ownImage;
          }
          body.style.setProperty('background-color', 'var(--bg)', 'important');
          body.style.setProperty('background-size', 'cover', 'important');
          body.style.setProperty('background-position', 'center', 'important');
          body.style.setProperty('background-attachment', window.matchMedia('(max-width: 700px)').matches ? 'scroll' : 'fixed', 'important');
          body.style.setProperty('background-repeat', 'no-repeat', 'important');
        };
        applyPageBackground();
        new MutationObserver(applyPageBackground).observe(document.documentElement, {
          attributes: true, attributeFilter: ['data-theme']
        });
      })();
    </script>
  </body>
</html>
