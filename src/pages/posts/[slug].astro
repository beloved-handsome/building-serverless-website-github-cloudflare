---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const dateFormat = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title={`${post.data.title} — Beloved`} description={post.data.description}>
  <article class="article-page">
    <a class="back-link notranslate" translate="no" href="/archive/" data-i18n="article.back">← 返回文章归档</a>
    <header class="article-header glass-panel">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
        <span class="meta-divider">/</span>
        <span class="post-category">{post.data.category}</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.tags.length > 0 && (
        <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
      )}
    </header>
    <div class="article-content glass-panel"><Content /></div>
    <div class="article-end glass-panel notranslate" translate="no">
      <span>✳</span>
      <p data-i18n="article.end">感谢阅读，下一篇文章再见。</p>
      <a class="text-link" href="/archive/" data-i18n="article.more">浏览更多文章 →</a>
    </div>
  </article>
</BaseLayout>
<style>
  .article-page { padding-top:24px; }
  .back-link { display:inline-flex;padding:7px 12px;border:1px solid var(--glass-border);border-radius:999px;background:var(--glass);color:var(--muted);font-size:12px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px); }
  .back-link:hover { color:var(--accent); }
  .article-header { margin-top:20px;padding:clamp(25px,5vw,46px);border-radius:24px; }
  .article-header h1 { margin:20px 0 14px;font-size:clamp(30px,6vw,43px);line-height:1.4;letter-spacing:-1.2px; }
  .article-description { color:var(--muted);font-size:14px; }
  .tag-list { display:flex;flex-wrap:wrap;gap:8px;margin-top:20px; }
  .tag { padding:3px 10px;border:1px solid var(--glass-border);border-radius:999px;background:rgba(255,255,255,.18);color:var(--muted);font-size:11px; }
  .article-content { margin-top:14px;padding:clamp(24px,5vw,42px);border-radius:22px;font-size:15px;line-height:2.1;overflow-wrap:anywhere; }
  .article-content :global(h2) { margin-top:2em;font-size:24px;line-height:1.5; }
  .article-content :global(h3) { margin-top:1.8em;font-size:19px; }
  .article-content :global(p) { margin:1.2em 0; }
  .article-content :global(a) { color:var(--accent);text-decoration:underline;text-underline-offset:3px; }
  .article-content :global(blockquote) { margin:1.5em 0;padding:4px 0 4px 18px;border-left:3px solid var(--accent);color:var(--muted); }
  .article-content :global(pre) { overflow-x:auto;padding:18px;border:1px solid var(--glass-border);border-radius:12px;background:rgba(255,255,255,.24);font-size:13px;line-height:1.8;backdrop-filter:blur(12px); }
  .article-content :global(code) { font-size:.9em; }
  .article-content :global(img) { display:block;max-width:100%;height:auto;margin:24px auto;border:1px solid var(--glass-border);border-radius:12px; }
  .article-content :global(li) { margin:5px 0; }
  .article-content :global(table) { display:block;max-width:100%;overflow-x:auto;border-collapse:collapse; }
  .article-content :global(th),.article-content :global(td) { padding:9px 12px;border:1px solid var(--glass-border); }
  .article-end { margin-top:14px;padding:30px;border-radius:18px;text-align:center; }
  .article-end>span { color:var(--accent);font-size:23px; }
  .article-end p { color:var(--muted);font-size:12px; }
  @media(max-width:700px) { .article-header,.article-content { padding:24px 18px; } }
</style>
