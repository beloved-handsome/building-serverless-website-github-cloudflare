
---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormat = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${post.data.title} — 你的名字`}
  description={post.data.description}
>
  <article class="article-page">
    <a class="back-link" href="/archive/">← 返回文章归档</a>

    <header class="article-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFormat.format(post.data.pubDate)}
        </time>
        <span class="meta-divider">/</span>
        <span class="post-category">{post.data.category}</span>
      </div>

      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <div class="tag-list">
          {post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="article-content">
      <Content />
    </div>

    <div class="article-end">
      <span>✳</span>
      <p>感谢阅读，下一篇文章再见。</p>
      <a class="text-link" href="/archive/">浏览更多文章 →</a>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page {
    padding-top: 42px;
  }

  .back-link {
    color: var(--muted);
    font-size: 12px;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .article-header {
    padding: 50px 0 35px;
    border-bottom: 1px solid var(--border);
  }

  .article-header h1 {
    margin: 20px 0 14px;
    font-size: clamp(30px, 6vw, 43px);
    line-height: 1.4;
    letter-spacing: -1.2px;
  }

  .article-description {
    color: var(--muted);
    font-size: 14px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }

  .tag {
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: 5px;
    color: var(--muted);
    font-size: 11px;
  }

  .article-content {
    padding: 34px 0;
    font-size: 15px;
    line-height: 2.1;
    overflow-wrap: anywhere;
  }

  .article-content :global(h2) {
    margin-top: 2em;
    font-size: 24px;
    line-height: 1.5;
  }

  .article-content :global(h3) {
    margin-top: 1.8em;
    font-size: 19px;
  }

  .article-content :global(p) {
    margin: 1.2em 0;
  }

  .article-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-content :global(blockquote) {
    margin: 1.5em 0;
    padding: 4px 0 4px 18px;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }

  .article-content :global(pre) {
    overflow-x: auto;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    font-size: 13px;
    line-height: 1.8;
  }

  .article-content :global(code) {
    font-size: 0.9em;
  }

  .article-content :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 24px auto;
    border-radius: 8px;
  }

  .article-content :global(li) {
    margin: 5px 0;
  }

  .article-end {
    padding: 30px 0;
    border-top: 1px solid var(--border);
    text-align: center;
  }

  .article-end > span {
    color: var(--accent);
    font-size: 23px;
  }

  .article-end p {
    color: var(--muted);
    font-size: 12px;
  }
</style>
