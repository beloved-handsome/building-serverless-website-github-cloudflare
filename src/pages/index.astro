---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = posts.slice(0, 6);
const dateFormat = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' });
---
<BaseLayout title="个人书房 — 记录生活，思考世界" description="记录生活、独立思考，观察社会与世界。">
  <section class="hero glass-panel">
    <div class="hero-eyebrow"><span class="status-dot"></span> 一个持续更新的个人空间</div>
    <p class="hero-overline">THE PRIVATE STUDY · NOTES ON LIFE & THE WORLD</p>
    <h1>记录生活，<br /><span class="muted-heading">思考世界。</span></h1>
    <p class="hero-description">这里是我的个人书房。收集读过的书、走过的路、遇见的人，也记录那些暂时没有答案的问题。愿每一次落笔，都更接近真实的自己。</p>
    <div class="hero-actions">
      <a class="button-primary" href="/archive/">开始阅读 <span aria-hidden="true">↗</span></a>
      <a class="button-secondary" href="/search/">在书房中搜索 <span aria-hidden="true">⌕</span></a>
      <a class="button-secondary" href="/wander/">随机读一篇 <span aria-hidden="true">✳</span></a>
    </div>
    <div class="hero-meta"><span>✳ 独立思考</span><span>⌘ 社会与世界</span><span>◷ 长期主义</span></div>
    <div class="hero-note"><span class="note-line"></span><span>“重要的不是答案，而是提出好问题的能力。”</span></div>
  </section>
  <section class="posts-section" aria-labelledby="posts-heading">
    <div class="section-heading"><div><p class="section-kicker">THE JOURNAL</p><h2 id="posts-heading">最近的记录</h2></div><a class="text-link" href="/archive/">全部文章 →</a></div>
    {recentPosts.length > 0 ? (
      <div class="post-grid">
        {recentPosts.map((post, i) => (
          <article class="post-item glass-panel">
            <a class="post-main" href={`/posts/${post.id}/`}>
              <div class="post-card-top"><span class="post-index">{String(i + 1).padStart(2, '0')}</span><span class="post-category">{post.data.category}</span></div>
              <div class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time></div>
              <h3>{post.data.title}</h3><p>{post.data.description}</p>
              {post.data.tags.length > 0 && <div class="mini-tags">{post.data.tags.slice(0, 3).map(tag => <span>{tag}</span>)}</div>}
            </a>
            <a class="post-arrow" href={`/posts/${post.id}/`} aria-label={`阅读：${post.data.title}`}>↗</a>
          </article>
        ))}
      </div>
    ) : <div class="empty-state glass-panel"><span class="empty-icon">✳</span><h3>书房还很安静</h3><p>在 src/content/posts/ 中添加 Markdown 文章，新的记录就会出现在这里。</p></div>}
  </section>
  <section class="about-strip glass-panel"><div class="about-symbol">阅</div><div><p class="section-kicker">A SMALL NOTE</p><h2>给思考留一点空间</h2><p>不急着给世界下结论，也不因为人声嘈杂就放弃自己的判断。欢迎在这里停留片刻。</p><a class="text-link" href="/about/">关于这个书房 →</a></div></section>
</BaseLayout>
