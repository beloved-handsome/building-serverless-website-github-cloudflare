---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---
<BaseLayout title="Beloved's Blog" description="记录生活的点滴，分享值得珍藏的瞬间。">
  <div class="blog-home">
    <section class="blog-hero">
      <div class="hero-overlay"></div>
      <svg class="hero-wave hero-wave-back" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,72 C180,120 300,22 500,64 C700,108 820,132 1010,78 C1190,26 1300,62 1440,82 L1440,180 L0,180 Z"></path>
      </svg>
      <svg class="hero-wave hero-wave-front" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,94 C190,54 320,126 520,98 C740,66 830,34 1030,88 C1200,132 1320,110 1440,72 L1440,180 L0,180 Z"></path>
      </svg>
      <div class="hero-heading">
        <h1>Beloved's Blog</h1>
        <p>🌿 记录生活的点滴，分享值得珍藏的瞬间。</p>
      </div>
    </section>

    <div class="home-layout">
      <aside class="profile-card glass-panel">
        <div class="profile-avatar" role="img" aria-label="个人头像"></div>
        <div class="profile-name">Beloved</div>
        <p class="profile-bio">记录、思考，慢慢生活。</p>
        <a class="profile-link" href="/about/">关于我　↗</a>
      </aside>

      <main class="home-main">
        <section class="shortcut-grid" aria-label="快捷导航">
          <a class="shortcut-card glass-panel" href="/archive/"><span class="shortcut-icon">▤</span><span class="shortcut-copy"><strong>文章归档</strong><small>按时间浏览文章</small></span></a>
          <a class="shortcut-card glass-panel" href="/search/"><span class="shortcut-icon">⌕</span><span class="shortcut-copy"><strong>搜索</strong><small>查找书房里的文章</small></span></a>
          <a class="shortcut-card glass-panel" href="/wander/"><span class="shortcut-icon">↗</span><span class="shortcut-copy"><strong>随机漫游</strong><small>随意发现一篇文章</small></span></a>
          <a class="shortcut-card glass-panel" href="/about/"><span class="shortcut-icon">✳</span><span class="shortcut-copy"><strong>关于</strong><small>了解这个博客</small></span></a>
        </section>

        <section class="latest-section">
          <div class="latest-heading"><h2>最近文章</h2><a href="/archive/">查看全部　↗</a></div>
          <div class="latest-grid">
            {posts.map((post) => (
              <a class="latest-card glass-panel" href={`/posts/${post.id}/`}>
                <div class="latest-card-body">
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description || '记录生活里的片段与想法。'}</p>
                  <span class="post-date">{post.data.pubDate.toLocaleDateString('zh-CN')}</span>
                </div>
              </a>
            ))}
            {posts.length === 0 && <div class="empty-posts glass-panel">还没有文章，写下第一篇吧。</div>}
          </div>
        </section>

        <section class="now-card glass-panel">
          <div class="now-title"><span>✦</span><strong data-live-label="welcome">此刻，世界正在发生。</strong></div>
          <div class="now-details"><span id="local-date">—</span><span id="local-time">--:--:--</span><span id="location-label" data-live-label="locating">正在读取所在位置…</span><span id="weather-label" data-live-label="weatherLoading">正在读取天气…</span></div>
        </section>
      </main>
    </div>
  </div>
</BaseLayout>
<script>
  const liveText: Record<string, Record<string, string>> = {
    zh: {welcome:'此刻，世界正在发生。',locating:'正在读取所在位置…',locationError:'暂时无法确定所在位置',weatherLoading:'正在读取天气…',weatherError:'暂时无法读取天气',footnote:'时间与天气，取自你所在的此刻。',clear:'晴朗',mostlyClear:'大致晴朗',partlyCloudy:'局部多云',cloudy:'多云',fog:'有雾',drizzle:'毛毛雨',rain:'有雨',snow:'有雪',showers:'阵雨',snowShowers:'阵雪',storm:'雷暴',unknown:'天气状况未知',feels:'体感',humidity:'湿度'},
    en: {welcome:'The world is happening, right now.',locating:'Finding your location…',locationError:'Location is temporarily unavailable',weatherLoading:'Loading local weather…',weatherError:'Weather is temporarily unavailable',footnote:'Time and weather, from your part of the world.',clear:'Clear sky',mostlyClear:'Mostly clear',partlyCloudy:'Partly cloudy',cloudy:'Overcast',fog:'Fog',drizzle:'Drizzle',rain:'Rain',snow:'Snow',showers:'Rain showers',snowShowers:'Snow showers',storm:'Thunderstorm',unknown:'Conditions unavailable',feels:'Feels like',humidity:'Humidity'},
    ja: {welcome:'今この瞬間も、世界は動いている。',locating:'現在地を取得しています…',locationError:'現在地を取得できません',weatherLoading:'現地の天気を取得しています…',weatherError:'天気を取得できません',footnote:'あなたのいる場所の時間と天気。',clear:'快晴',mostlyClear:'おおむね晴れ',partlyCloudy:'晴れ時々くもり',cloudy:'くもり',fog:'霧',drizzle:'霧雨',rain:'雨',snow:'雪',showers:'にわか雨',snowShowers:'にわか雪',storm:'雷雨',unknown:'天気情報なし',feels:'体感',humidity:'湿度'},
    ko: {welcome:'지금 이 순간에도 세계는 움직입니다.',locating:'위치를 확인하는 중…',locationError:'현재 위치를 확인할 수 없습니다',weatherLoading:'현지 날씨를 불러오는 중…',weatherError:'날씨 정보를 가져올 수 없습니다',footnote:'당신이 있는 곳의 시간과 날씨.',clear:'맑음',mostlyClear:'대체로 맑음',partlyCloudy:'구름 조금',cloudy:'흐림',fog:'안개',drizzle:'이슬비',rain:'비',snow:'눈',showers:'소나기',snowShowers:'눈 소나기',storm:'뇌우',unknown:'날씨 정보 없음',feels:'체감',humidity:'습도'}
  };
  const languageCodes: Record<string,string> = {zh:'zh-CN',en:'en',ja:'ja-JP',ko:'ko-KR'};
  const dateEl = document.querySelector<HTMLElement>('#local-date');
  const timeEl = document.querySelector<HTMLElement>('#local-time');
  const locationEl = document.querySelector<HTMLElement>('#location-label');
  const weatherEl = document.querySelector<HTMLElement>('#weather-label');
  const symbolEl = document.querySelector<HTMLElement>('#weather-symbol');
  let language = document.documentElement.dataset.language || 'zh';
  let timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  let weatherData: {temperature:number;apparent:number;humidity:number;code:number;wind:number} | null = null;
  let locationName = '';
  let clockTimer: number | undefined;
  const weatherKey = (code:number) => code === 0 ? 'clear' : code === 1 ? 'mostlyClear' : code === 2 ? 'partlyCloudy' : code === 3 ? 'cloudy' : code === 45 || code === 48 ? 'fog' : code >= 51 && code <= 57 ? 'drizzle' : code >= 71 && code <= 77 ? 'snow' : code >= 85 && code <= 86 ? 'snowShowers' : code >= 80 && code <= 82 ? 'showers' : code >= 95 ? 'storm' : code >= 61 && code <= 67 ? 'rain' : 'unknown';
  function updateClock() {
    const locale = languageCodes[language] || 'zh-CN';
    if (dateEl) dateEl.textContent = new Intl.DateTimeFormat(locale,{weekday:'long',year:'numeric',month:'long',day:'numeric',timeZone}).format(new Date());
    if (timeEl) timeEl.textContent = new Intl.DateTimeFormat(locale,{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false,timeZone}).format(new Date());
  }
  function updateLabels() {
    const t = liveText[language] || liveText.zh;
    document.querySelectorAll<HTMLElement>('[data-live-label]').forEach(el => {
      const key = el.dataset.liveLabel || '';
      if (key === 'location' && locationName) el.textContent = locationName;
      else if (key === 'weather' && weatherData) el.textContent = `${t[weatherKey(weatherData.code)]} · ${Math.round(weatherData.temperature)}° · ${t.feels} ${Math.round(weatherData.apparent)}° · ${t.humidity} ${weatherData.humidity}%`;
      else if (t[key]) el.textContent = t[key];
    });
    if (locationEl && locationName) locationEl.textContent = locationName;
    if (weatherEl && weatherData) {
      weatherEl.textContent = `${t[weatherKey(weatherData.code)]} · ${Math.round(weatherData.temperature)}° · ${t.feels} ${Math.round(weatherData.apparent)}° · ${t.humidity} ${weatherData.humidity}%`;
      if (symbolEl) symbolEl.textContent = weatherData.code === 0 || weatherData.code === 1 ? '☼' : weatherData.code >= 95 ? 'ϟ' : weatherData.code >= 71 ? '❄' : weatherData.code >= 51 ? '☂' : '☁';
    }
  }
  function startClock() {
    if (clockTimer) window.clearInterval(clockTimer);
    updateClock();
    clockTimer = window.setInterval(updateClock, 1000);
  }
  startClock();
  window.addEventListener('study-room-language-change', event => {
    language = (event as CustomEvent).detail?.language || 'zh';
    startClock();
    updateLabels();
  });
  updateLabels();
  function getBrowserPosition(): Promise<GeolocationPosition> {
    return new Promise((resolve, reject) => {
      if (!('geolocation' in navigator)) { reject(new Error('Geolocation unsupported')); return; }
      navigator.geolocation.getCurrentPosition(resolve, reject, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
    });
  }
  async function loadLocalWeather() {
    try {
      let latitude: number;
      let longitude: number;
      let accurateLocation = false;
      try {
        const position = await getBrowserPosition();
        latitude = position.coords.latitude;
        longitude = position.coords.longitude;
        accurateLocation = position.coords.accuracy <= 1000;
        try {
          const reverseUrl = new URL('https://api.bigdatacloud.net/data/reverse-geocode-client');
          reverseUrl.search = new URLSearchParams({ latitude: String(latitude), longitude: String(longitude), localityLanguage: languageCodes[language] || 'en' }).toString();
          const reverseResponse = await fetch(reverseUrl);
          if (reverseResponse.ok) {
            const place = await reverseResponse.json();
            locationName = [place.city || place.locality, place.principalSubdivision, place.countryName].filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join(', ');
          }
        } catch { /* Weather still works if reverse geocoding fails. */ }
      } catch {
        const response = await fetch('https://ipwho.is/');
        if (!response.ok) throw new Error('IP geolocation unavailable');
        const place = await response.json();
        if (!place.success || typeof place.latitude !== 'number' || typeof place.longitude !== 'number') throw new Error('IP geolocation unavailable');
        latitude = place.latitude;
        longitude = place.longitude;
        timeZone = place.timezone?.id || timeZone;
        locationName = [place.city, place.region, place.country].filter(Boolean).filter((v,i,a)=>a.indexOf(v)===i).join(', ');
      }
      const t = liveText[language] || liveText.zh;
      if (locationEl) {
        locationEl.dataset.liveLabel = 'location';
        locationEl.textContent = locationName || t.locationError;
        locationEl.title = accurateLocation ? 'GPS location' : 'Approximate location';
      }
      startClock();
      const url = new URL('https://api.open-meteo.com/v1/forecast');
      url.search = new URLSearchParams({ latitude: String(latitude), longitude: String(longitude), current: 'temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m', timezone: 'auto' }).toString();
      const weatherResponse = await fetch(url);
      if (!weatherResponse.ok) throw new Error('Weather unavailable');
      const result = await weatherResponse.json();
      const current = result.current;
      weatherData = { temperature: current.temperature_2m, apparent: current.apparent_temperature, humidity: current.relative_humidity_2m, code: current.weather_code, wind: current.wind_speed_10m };
      if (weatherEl) weatherEl.dataset.liveLabel = 'weather';
      updateLabels();
    } catch {
      const current = liveText[language] || liveText.zh;
      if (locationEl && !locationName) { locationEl.dataset.liveLabel = 'locationError'; locationEl.textContent = current.locationError; }
      if (weatherEl && !weatherData) { weatherEl.dataset.liveLabel = 'weatherError'; weatherEl.textContent = current.weatherError; }
    }
  }
</script>
<style>
  .blog-home { padding-bottom:36px; }
  /* Homepage banner: the photo ends at the hero edge; the wave is a static, continuous divider. */
  :global(body[data-page="home"]) { background-color:#d8d8d8 !important; background-image:none !important; }
  :global(body[data-page="home"] .site-header) { background:transparent !important; border-color:transparent !important; box-shadow:none !important; backdrop-filter:none !important; -webkit-backdrop-filter:none !important; }
  .profile-card,.shortcut-card,.latest-card,.empty-posts,.now-card { background:transparent !important; border:0 !important; box-shadow:none !important; backdrop-filter:none !important; -webkit-backdrop-filter:none !important; }
  .blog-hero { width:100vw;min-height:620px;position:relative;display:grid;place-items:center;overflow:hidden;margin:0 calc(50% - 50vw) 0;border-radius:0;border:0;background:linear-gradient(0deg,rgba(25,20,30,.40),rgba(25,20,30,.06)),url('/backgrounds/home/background.jpg') center 46%/cover no-repeat,linear-gradient(125deg,#746a7e,#c88d89 55%,#e4c8a2);box-shadow:none; }
  .hero-overlay { position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,18,28,.18),transparent 70%); }
  /* Two independently moving wave layers create the animated shoreline seen in the reference. */
  .hero-wave { position:absolute;z-index:2;left:0;bottom:-1px;width:100%;height:180px;pointer-events:none;transform:none;animation:none; }
  .hero-wave path { fill:#d8d8d8; }
  .hero-wave-back { opacity:.58; }
  .hero-wave-back path { fill:#e2e2e2; }
  .hero-wave-front { opacity:1; }
  .hero-wave-front path { fill:#d8d8d8; }
  @keyframes hero-wave-drift { from { transform:translateX(0); } to { transform:translateX(0); } }
  @media(prefers-reduced-motion:reduce) { .hero-wave-back,.hero-wave-front { animation:none; } }
  .hero-heading { position:relative;z-index:1;text-align:center;color:white;padding:clamp(70px,10vw,130px) 16px clamp(90px,12vw,150px);text-shadow:0 2px 22px rgba(0,0,0,.22); }
  .hero-heading h1 { margin:0;font-size:clamp(40px,7vw,62px);line-height:1.2;letter-spacing:.01em;font-weight:600; }
  .hero-heading p { margin:14px 0 0;font-size:clamp(13px,2vw,17px); }
  .home-layout { display:grid;grid-template-columns:190px minmax(0,1fr);gap:18px;align-items:start; }
  .profile-card { position:sticky;top:96px;display:flex;flex-direction:column;align-items:center;text-align:center;padding:20px 14px;border-radius:0; }
  .profile-avatar { width:112px;height:112px;border-radius:16px;background:var(--accent-soft) url('/profile/avatar.jpg') center/cover no-repeat;box-shadow:inset 0 0 0 1px var(--glass-border); }
  .profile-name { margin-top:12px;font-weight:700;font-size:15px; }
  .profile-bio { margin:2px 0 8px;color:var(--muted);font-size:11px; }
  .profile-link { color:var(--accent);font-size:11px; }
  .home-main { min-width:0; }
  .shortcut-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px; }
  .shortcut-card { display:flex;align-items:center;gap:11px;min-width:0;padding:15px 0;border-radius:0;transition:transform .2s; }
  .shortcut-card:hover,.latest-card:hover { transform:translateY(-2px);border-color:transparent; }
  .shortcut-icon { display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:10px;background:var(--accent-soft);color:var(--accent);font-size:20px; }
  .shortcut-copy { min-width:0; }
  .shortcut-copy strong,.shortcut-copy small { display:block; }
  .shortcut-copy strong { font-size:12px; }
  .shortcut-copy small { margin-top:2px;color:var(--muted);font-size:10px; }
  .latest-section { margin-top:22px; }
  .latest-heading { display:flex;justify-content:space-between;align-items:center;margin-bottom:10px; }
  .latest-heading h2 { margin:0;font-size:17px; }
  .latest-heading>a { color:var(--muted);font-size:11px; }
  .latest-grid { display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px; }
  .latest-card { display:block;overflow:hidden;min-width:0;border-radius:0;transition:transform .2s; }
  .latest-card-body { padding:13px; }
  .latest-card h3 { margin:0;font-size:13px;line-height:1.6; }
  .latest-card p { margin:5px 0 10px;color:var(--muted);font-size:10px;line-height:1.7;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden; }
  .post-date { color:var(--muted);font-size:10px; }
  .empty-posts { grid-column:1/-1;padding:24px;text-align:center;color:var(--muted);font-size:12px;border-radius:0; }
  .now-card { margin-top:14px;padding:14px 0;border-radius:0; }
  .now-title { display:flex;align-items:center;gap:8px;font-size:12px; }
  .now-title span { color:var(--accent); }
  .now-details { display:flex;flex-wrap:wrap;gap:5px 14px;margin-top:8px;color:var(--muted);font-size:10px; }
  @media(max-width:700px) { .blog-hero { width:100vw;min-height:540px;margin:0 calc(50% - 50vw) 0;border-radius:0; }.home-layout { grid-template-columns:1fr; }.profile-card { position:static;order:2;flex-direction:row;text-align:left;gap:12px;padding:13px; }.profile-avatar { width:64px;height:64px;flex:0 0 64px;border-radius:12px; }.profile-name { margin-top:0; }.profile-bio { margin:2px 0 4px; }.profile-card>div:not(.profile-avatar) { min-width:0; }.profile-link { display:block; }.latest-section { margin-top:18px; } }
  @media(max-width:450px) { .shortcut-grid,.latest-grid { gap:8px; }.shortcut-card { padding:11px 9px;gap:8px; }.shortcut-icon { flex-basis:29px;height:29px;font-size:17px; }.shortcut-copy strong { font-size:11px; }.shortcut-copy small { font-size:9px; }.latest-card-body { padding:10px; } }
</style>
