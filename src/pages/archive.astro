---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = Object.groupBy(
  posts,
  (post) => String(post.data.pubDate.getFullYear()),
);
---
<BaseLayout title="文章归档 — Beloved" description="浏览 Beloved 的全部文章。">
  <section class="archive-page glass-panel">
    <p class="section-kicker" data-i18n="archive.kicker">THE ARCHIVE</p>
    <h1 data-i18n="archive.title">文章归档<span>.</span></h1>
    <p class="archive-intro" data-i18n="archive.intro" data-archive-count={posts.length}>所有写过的东西，都在这里留下痕迹。共 {posts.length} 篇文章。</p>
    {Object.entries(groups)
      .sort(([a], [b]) => Number(b) - Number(a))
      .map(([year, yearPosts]) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <div class="archive-list">
            {yearPosts!.map((post) => (
              <a class="archive-item" href={`/posts/${post.id}/`}>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
                <span>{post.data.title}</span>
                <span class="archive-arrow">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
  </section>
</BaseLayout>
<style>
  .archive-page { padding:clamp(25px,5vw,48px);margin-top:24px;border-radius:24px; }
  .archive-page h1 { margin:10px 0;font-size:clamp(36px,6vw,48px);letter-spacing:-1.5px; }
  .archive-page h1 span { color:var(--accent); }
  .archive-intro { margin:0;color:var(--muted);font-size:13px; }
  .archive-year { margin-top:38px; }
  .archive-year h2 { margin:0 0 12px;font-size:22px;color:var(--accent); }
  .archive-list { display:grid;gap:9px;border:0; }
  .archive-item { display:grid;grid-template-columns:60px minmax(0,1fr) 20px;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--glass-border);border-radius:13px;background:var(--glass);box-shadow:var(--glass-shadow);font-size:13px;backdrop-filter:blur(var(--glass-blur));-webkit-backdrop-filter:blur(var(--glass-blur)); }
  .archive-item time,.archive-arrow { color:var(--muted); }
  .archive-item:hover>span:nth-child(2) { color:var(--accent); }
</style>
