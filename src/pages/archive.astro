---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const groups = Object.groupBy(
  posts,
  (post) => String(post.data.pubDate.getFullYear()),
);
---
<BaseLayout title="文章归档 — Beloved" description="浏览 Beloved 的全部文章。">
  <section class="interior-hero interior-hero-archive" aria-label="文章归档">
    <div class="interior-hero-shade"></div>
    <div class="interior-hero-copy">
      <p class="interior-kicker">ARCHIVE</p>
      <h1 data-i18n="archive.title">文章归档<span>.</span></h1>
      <p data-i18n="archive.intro" data-archive-count={posts.length}>浏览所有文章，按时间寻找留下的记录。</p>
    </div>
  </section>
  <div class="interior-waves" aria-hidden="true">
    <svg viewBox="0 24 150 28" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs><path id="interior-wave-archive" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"></path></defs>
      <g class="interior-wave-parallax">
        <use href="#interior-wave-archive" x="48" y="0" class="iw-1"></use><use href="#interior-wave-archive" x="48" y="3" class="iw-2"></use><use href="#interior-wave-archive" x="48" y="5" class="iw-3"></use><use href="#interior-wave-archive" x="48" y="7" class="iw-4"></use>
      </g>
    </svg>
  </div>

  <section class="archive-page interior-content glass-panel">
    
    {Object.entries(groups)
      .sort(([a], [b]) => Number(b) - Number(a))
      .map(([year, yearPosts]) => (
        <section class="archive-year">
          <h2>{year}</h2>
          <div class="archive-list">
            {yearPosts!.map((post) => (
              <a class="archive-item" href={`/posts/${post.id}/`} data-post-slug={post.id}>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                </time>
                <span class="archive-post-title" data-original-title={post.data.title}>{post.data.title}</span>
                <span class="archive-arrow">↗</span>
              </a>
            ))}
          </div>
        </section>
      ))}
  </section>
</BaseLayout>
<style>
  .archive-page { padding:clamp(25px,5vw,48px);margin-top:24px;border-radius:24px; }
  .archive-page h1 { margin:10px 0;font-size:clamp(36px,6vw,48px);letter-spacing:-1.5px; }
  .archive-page h1 span { color:var(--accent); }
  .archive-intro { margin:0;color:var(--muted);font-size:13px; }
  .archive-year { margin-top:38px; }
  .archive-year h2 { margin:0 0 12px;font-size:22px;color:var(--accent); }
  .archive-list { display:grid;gap:9px;border:0; }
  .archive-item { display:grid;grid-template-columns:60px minmax(0,1fr) 20px;align-items:center;gap:12px;padding:14px 16px;border:1px solid var(--glass-border);border-radius:13px;background:var(--glass);box-shadow:var(--glass-shadow);font-size:13px;backdrop-filter:blur(var(--glass-blur));-webkit-backdrop-filter:blur(var(--glass-blur)); }
  .archive-item time,.archive-arrow { color:var(--muted); }
  .archive-item:hover>span:nth-child(2) { color:var(--accent); }
</style>
