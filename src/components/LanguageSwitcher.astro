      'article.back':'← 返回文章归档','article.end':'感谢阅读，下一篇文章再见。','article.more':'浏览更多文章 →',
      'theme.title':'切换深色模式'
    },
    en: {
      'nav.home':'Home','nav.archive':'Archive','nav.search':'Search','nav.about':'About','nav.wander':'Wander ↗','nav.aiAssistant':'AI Assistant',
      'footer.motto':'Stay curious. Think independently. · Quietly built with <a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>',
      'home.eyebrow':'A personal space, always in progress','home.overline':'THE PRIVATE STUDY · NOTES ON LIFE & THE WORLD',
      'home.title':'Record life,<br><span class="muted-heading">reflect on the world.</span>',
      'home.description':'Welcome to my private study. Here I collect books read, roads travelled, people met, and questions without easy answers. May every line bring me closer to who I really am.',
      'home.read':'Start reading <span aria-hidden="true">↗</span>','home.search':'Search the study <span aria-hidden="true">⌕</span>','home.random':'Read something random <span aria-hidden="true">✳</span>',
      'home.meta':'<span>✳ Independent thought</span><span>⌘ Society & the world</span><span>◷ Long-term thinking</span>',
      'home.quote':'“The point is not having answers, but asking better questions.”','home.journal':'THE JOURNAL','home.recent':'Recent notes','home.all':'All articles →',
      'home.emptyTitle':'The study is quiet for now','home.empty':'Add Markdown posts to src/content/posts/ and they will appear here.',
      'home.note':'A SMALL NOTE','home.space':'Make room for thought','home.noteText':'There is no need to rush to judge the world, or abandon your own judgment in the noise. Stay a while.','home.about':'About this study →',
      'home.heroTitle':'Beloved’s Blog','home.heroSubtitle':'🌿 Small moments of life, worth keeping.','home.avatarAria':'Profile avatar','home.profileName':'Beloved','home.profileBio':'Recording, reflecting, and taking life slowly.','home.profileLink':'About me　↗','home.shortcutsAria':'Quick links','home.shortcutArchive':'Archive','home.shortcutArchiveDesc':'Browse posts by date','home.shortcutSearch':'Search','home.shortcutSearchDesc':'Find a post in the study','home.shortcutWander':'Wander','home.shortcutWanderDesc':'Discover a random post','home.shortcutAbout':'About','home.shortcutAboutDesc':'Learn about this blog','home.latestTitle':'Latest posts','home.latestAll':'View all　↗','home.emptyPosts':'No posts yet. Write the first one.','home.defaultPostDescription':'A few moments and thoughts from everyday life.',
      'search.kicker':'FIND A NOTE','search.title':'Search Beloved<span>.</span>','search.intro':'Find a note by title, summary, category, or tag.','search.placeholder':'Try books, life, reflection…','search.aria':'Search articles','search.hint':'{n} articles. Enter a keyword to search.','search.found':'Found {n} related articles','search.noneTitle':'No matching notes','search.none':'Try another keyword.',
      'wander.kicker':'SERENDIPITY','wander.title':'Wander<span>.</span>','wander.intro':'You do not always need a question. Let the next article choose the direction.','wander.ready':'Ready to stumble upon a thought?','wander.desc':'Click below to open a random article from the study.','wander.button':'Take me there ↗','wander.empty':'There are no posts yet. Add a few notes to begin.',
      'archive.kicker':'THE ARCHIVE','archive.title':'Archive<span>.</span>','archive.intro':'Browse all posts by date and revisit your notes. {n} articles in total.',
      'about.kicker':'ABOUT ME','about.title':'About me<span>.</span>','about.lead':'Hello, I’m glad you’re here.','about.p1':'I enjoy exploring, recording, and thinking. This blog holds technical experiments, reflections on life, and moments worth keeping.','about.h2':'About this blog','about.p2':'Built with Astro, managed on GitHub, and deployed on Cloudflare. I hope it stays simple, fast, and easy to maintain.','about.find':'Find me','about.p3':'You can reach me through GitHub. ','about.back':'← Back home',
      'article.back':'← Back to archive','article.end':'Thanks for reading. See you in the next post.','article.more':'Browse more articles →',
      'theme.title':'Toggle dark mode'
    },
  };
  // Persistent sitewide zh/en dictionary: new or rebuilt page copy should use data-i18n keys.
  // The selected language is reapplied after Astro navigation, so refactors retain translations.
  const selector = document.querySelector<HTMLSelectElement>('#site-language');

  function translated(text: string, language: string): string {
    return language === 'en' ? (englishText[text] || text) : text;
  }

  function translateArticle(language: string) {
    const article = document.querySelector<HTMLElement>('.article-page');
    if (!article) return;

    const dateElement = article.querySelector<HTMLTimeElement>('time[datetime]');
    if (dateElement?.dateTime) {
      const date = new Date(dateElement.dateTime);
      dateElement.textContent = date.toLocaleDateString(language === 'en' ? 'en-US' : 'zh-CN', {
        year: 'numeric', month: 'long', day: 'numeric'
      });
    }

    const nodes = Array.from(article.querySelectorAll<HTMLElement>(
      '.article-header h1, .article-description, .post-category, .tag-list .tag, .article-content h1, .article-content h2, .article-content h3, .article-content h4, .article-content p, .article-content li, .article-content blockquote, .article-content th, .article-content td'
    )).filter(el => el.childElementCount === 0 && !el.closest('pre,code,a,button'));

    nodes.forEach(el => {
      if (!el.dataset.translatedOriginal) {
        el.dataset.translatedOriginal = el.textContent || '';
      }
      const original = el.dataset.translatedOriginal || '';
      el.textContent = language === 'en' ? (englishText[original] || original) : original;
    });

    article.dataset.translationState = 'ready';
  }

  function applyLanguage(language: string) {
    const lang = language === 'en' ? 'en' : 'zh';
    document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
    document.documentElement.dataset.language = lang;

    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const value = dictionaries[lang][el.dataset.i18n || ''];
      if (value !== undefined) el.innerHTML = value;
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach(el => {
      const value = dictionaries[lang][el.dataset.i18nPlaceholder || ''];
      if (value !== undefined) el.setAttribute('placeholder', value);
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach(el => {
      const value = dictionaries[lang][el.dataset.i18nAria || ''];
      if (value !== undefined) el.setAttribute('aria-label', value);
    });
    document.querySelectorAll<HTMLElement>('[data-i18n-title]').forEach(el => {
      const value = dictionaries[lang][el.dataset.i18nTitle || ''];
      if (value !== undefined) el.setAttribute('title', value);
    });

    // Translate dynamic homepage post metadata using the shared Chinese→English dictionary.
    document.querySelectorAll<HTMLElement>('[data-home-post-title], [data-home-post-description]').forEach(el => {
      if (!el.dataset.translatedOriginal) {
        el.dataset.translatedOriginal = el.textContent || '';
      }
      const original = el.dataset.translatedOriginal || '';
      el.textContent = lang === 'en' ? (englishText[original] || original) : original;
    });
    document.querySelectorAll<HTMLTimeElement>('[data-home-post-date]').forEach(el => {
      if (!el.dataset.originalDate) el.dataset.originalDate = el.dateTime;
      if (el.dataset.originalDate) {
        el.textContent = new Date(el.dataset.originalDate).toLocaleDateString(lang === 'en' ? 'en-US' : 'zh-CN');
      }
    });

    const count = document.querySelector<HTMLElement>('[data-search-count]');
    if (count) {
      const total = Number(count.dataset.total || 0);
      count.textContent = (dictionaries[lang]['search.hint'] || '').replace('{n}', String(total));
    }

    const archiveIntro = document.querySelector<HTMLElement>('[data-archive-count]');
    const archiveTitles = Array.from(document.querySelectorAll<HTMLElement>('.archive-item[data-post-slug] .archive-post-title'));
    archiveTitles.forEach(el => {
      const original = el.dataset.originalTitle || el.textContent || '';
      el.textContent = translated(original, lang);
    });
    if (archiveIntro) archiveIntro.textContent = (dictionaries[lang]['archive.intro'] || '').replace('{n}', archiveIntro.dataset.archiveCount || '0');

    const path = window.location.pathname;
    const pageTitles: Record<string, Record<string,string>> = {
      '/': {zh:'Beloved',en:'Beloved'},
      '/search/': {zh:'搜索 — Beloved',en:'Search — Beloved'},
      '/wander/': {zh:'随机漫游 — Beloved',en:'Wander — Beloved'},
      '/archive/': {zh:'文章归档 — Beloved',en:'Archive — Beloved'},
      '/about/': {zh:'关于 — Beloved',en:'About — Beloved'}
    };
    if (path.startsWith('/posts/')) {
      translateArticle(lang);
      const articleTitle = document.querySelector<HTMLElement>('.article-header h1');
      if (articleTitle) document.title = (articleTitle.textContent || '').trim() + ' — Beloved';
    } else if (pageTitles[path]?.[lang]) {
      document.title = pageTitles[path][lang];
    }

    const theme = document.querySelector<HTMLButtonElement>('.theme-toggle');
    if (theme) {
      theme.title = dictionaries[lang]['theme.title'] || 'Toggle theme';
      theme.setAttribute('aria-label', theme.title);
    }
    if (selector) selector.value = lang;
    try { localStorage.setItem('study-room-language', lang); } catch {}

    window.dispatchEvent(new CustomEvent('study-room-language-change', {
      detail: { language: lang, dictionary: dictionaries[lang], englishText }
    }));
  }

  const savedLanguage = (() => {
    try { return localStorage.getItem('study-room-language') || 'zh'; } catch { return 'zh'; }
  })();

  applyLanguage(savedLanguage);
  selector?.addEventListener('change', () => applyLanguage(selector.value));
  document.addEventListener('astro:page-load', () => applyLanguage(selector?.value || savedLanguage));
</script>
